    {
      "name": "books",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"books\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"authors\" TEXT NOT NULL, \"series\" TEXT NULL, \"series_number\" INTEGER NULL, \"lang\" TEXT NULL, \"annotation\" TEXT NULL, \"source_format\" TEXT NOT NULL, \"source_name\" TEXT NOT NULL, \"source_size\" INTEGER NOT NULL, \"source_hash\" TEXT NOT NULL UNIQUE, \"parser_version\" INTEGER NOT NULL, \"word_count\" INTEGER NOT NULL, \"position_word\" INTEGER NOT NULL DEFAULT 0, \"position_section\" INTEGER NOT NULL DEFAULT 0, \"position_block\" INTEGER NOT NULL DEFAULT 0, \"position_char\" INTEGER NOT NULL DEFAULT 0, \"added_at\" INTEGER NOT NULL, \"opened_at\" INTEGER NULL, \"touched_at\" INTEGER NOT NULL, \"cover_file\" TEXT NULL, \"finished_at\" INTEGER NULL, \"status_mark\" TEXT NULL);"
        }
      ]
    },
